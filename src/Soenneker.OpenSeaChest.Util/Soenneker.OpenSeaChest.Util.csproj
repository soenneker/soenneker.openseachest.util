<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Features Condition="'$(TargetFramework)' == 'net11.0'">$(Features);runtime-async=on</Features>
        <IsAotCompatible>true</IsAotCompatible>
        <Nullable>enable</Nullable>
        <Platforms>AnyCPU</Platforms>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <Description>A process-based utility for openSeaChest storage device diagnostics and management.</Description>
        <Version Condition="'$(BUILD_VERSION)' == ''">11.0.0</Version>
        <Version Condition="'$(BUILD_VERSION)' != ''">$(BUILD_VERSION)</Version>
        <AssemblyName>Soenneker.OpenSeaChest.Util</AssemblyName>
        <PackageId>Soenneker.OpenSeaChest.Util</PackageId>
        <PackageTags>openseachest util storage diagnostics process utility openseachestutil csharp dotnet c# .net</PackageTags>
        <Copyright>Copyright © 2026 Jake Soenneker</Copyright>
        <Authors>Jake Soenneker</Authors>
        <Company>https://soenneker.com</Company>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <IsPackable>true</IsPackable>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/soenneker/soenneker.openseachest.util</PackageProjectUrl>
        <RepositoryUrl>https://github.com/soenneker/soenneker.openseachest.util</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <RepositoryBranch>main</RepositoryBranch>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <LangVersion>latest</LangVersion>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
        <PackageReleaseNotes Condition="'$(PACKAGE_RELEASE_NOTES)' != ''">$(PACKAGE_RELEASE_NOTES)</PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
        <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Soenneker.Utils.Paths.Resources" Version="11.0.301" />
        <PackageReference Include="Soenneker.Utils.Process" Version="11.0.1602" />
        <PackageReference Include="Soenneker.Utils.File" Version="11.0.2325" />
        <PackageReference Include="Soenneker.Utils.Runtime" Version="11.0.1156" />
        <PackageReference Include="Soenneker.Utils.PooledStringBuilders" Version="11.0.44" />
        <PackageReference Include="Soenneker.Gen.EnumValues" Version="11.0.65" />
        <!-- Propagate the native content files through downstream packages. -->
        <PackageReference Include="Soenneker.OpenSeaChest.Binaries" Version="4.0.3" PrivateAssets="none" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Soenneker.OpenSeaChest.Util.Tests" />
    </ItemGroup>
</Project>

